#BUILD_INTENT_SKIP_INTENTS=0
#BUILD_INTENT_INDEX_ONLY=0
#BUILD_INTENT_FROM_STAGE=auto
#BUILD_INTENT_FUNCTION_INTENT_LIMIT=0
#BUILD_INTENT_FUNCTIONS_ONLY=0
#BUILD_INTENT_PREVIEW_COUNT=0
#BUILD_INTENT_PREVIEW_ONLY=0
#BUILD_INTENT_MAX_WORKERS=5
#BUILD_INTENT_SHELL_AFTER_INDEX=0
#BUILD_INTENT_CMAKE_ARGS=

# =============================================================================
# code_intent/batch_index.py — BATCH_INDEX_*
# =============================================================================
#BATCH_INDEX_DEMO_SCRIPT=
#BATCH_INDEX_SUMMARY_LOG=
#BATCH_INDEX_LIMIT=0
#BATCH_INDEX_SKIP_EXISTING=0
#BATCH_INDEX_RESUME=0
# 同时跑几个实例的 docker 索引（batch_index --parallel-instances）；未设时读 BATCH_INDEX_MAX_WORKERS
#BATCH_INDEX_PARALLEL_INSTANCES=2
#BATCH_INDEX_MAX_WORKERS=0
#BATCH_INDEX_EXCLUDE=
#BATCH_INDEX_JSONL=
#BATCH_INDEX_GIT_BASE_URL=https://github.com
#BATCH_INDEX_FORCE_RECLONE=0
# JSONL：上游缓存目录（默认 repo-dir/_upstream/<repo>）已存在时仍会 git fetch origin；TLS 不稳且本地已有足够提交时可设 1 跳过（缺少远端新提交会导致 checkout 失败）
#BATCH_INDEX_SKIP_UPSTREAM_FETCH=0
# ccache 增量构建：指向宿主机上的持久化 ccache 目录；首次 make libs（LLVM）约 2h 暖 cache，
# 同一 LLVM submodule commit 的后续实例 make libs 将命中 cache（秒级完成）。
# demo.py 会把该目录 bind-mount 进容器并注入 CMAKE_C/CXX_COMPILER_LAUNCHER=ccache。
#BATCH_INDEX_CCACHE_DIR=/data/dqa/ccache/ponyc
# ponyc 默认在宿主 clone 后拉 git 子模块（LLVM）；恢复旧行为（进容器再拉）设 BATCH_INDEX_SKIP_SUBMODULES=1
#BATCH_INDEX_SKIP_SUBMODULES=0
# 先 ``git clone --mirror https://github.com/llvm/llvm-project.git /path/llvm-project.git``，再设下面变量，ponyc 的 submodule update 会加 ``--reference`` 复用对象，减少重复下载
#BATCH_INDEX_LLVM_SUBMODULE_REFERENCE=/data/dqa/git-cache/llvm-project.git
# batch_index：ponyc 且宿主 clone 下 lib/llvm/src 已非空时会自动设置 CODE_INTENT_HOST_REPO_BIND（你未显式设置时），否则容器内 make 仍会 clone LLVM
# 非 ponyc 仓库也在宿主拉子模块时设 BATCH_INDEX_FETCH_SUBMODULES=1
#BATCH_INDEX_FETCH_SUBMODULES=0
# 与 BATCH_INDEX_RESUME=1 合用：合并目录内所有 .log 的 [SUCCESS] 后跳过（主 summary 被覆盖时把历史日志放此目录）
#BATCH_INDEX_RESUME_LOG_DIR=code_intent/batch_index_logs
#BATCH_INDEX_RESUME_LOG_RECURSIVE=0
# 与 BATCH_INDEX_RETRY_FAILED=1 合用：合并目录内 [FAILURE]
#BATCH_INDEX_RETRY_FAILED_LOG_DIR=
#BATCH_INDEX_RETRY_FAILED_LOG_RECURSIVE=0

# =============================================================================
