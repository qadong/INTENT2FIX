# 复制为 `.env` 后按需填写。布尔未设置视为关；1 / true / yes / on 视为开。
# `build_intent` / `batch_*` 启动时会尝试加载「仓库根/.env」或「code_intent/.env」。

# =============================================================================
# 全局路径（目录语义只用这三个名；代码与文档不再使用同义别名）
# =============================================================================
# 评测与运行产物根（与 REPO_DIR / INDEX_STORE_DIR 不同语义）
INTENT2FIX_DIR=/tmp/INTENT2FIX
# 各 SweBench 实例源码目录的父路径
REPO_DIR=/tmp/repos
# 索引与 intent 输出根（entity_tools、CodeIndex、build_intent --output-path 默认）
INDEX_STORE_DIR=/tmp/INTENT2FIX/index-store
# 各实例独立 build 的父目录（batch_index --build-dir 默认；未设则用代码内默认路径）
#INTENT2FIX_BUILD_DIR=/tmp/INTENT2FIX/builds

# =============================================================================
# API 密钥（按需）
# =============================================================================
VOYAGE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
# Z.AI general API key used by the `glm-5.3-flash` model alias.
ZAI_API_KEY=
# Volcengine Ark inference key. The project alias
# `volcengine-deepseek-v4-flash` selects the pre-0731 260425 build.
ARK_API_KEY=
#OPENROUTER_API_KEY=

# =============================================================================
# scripts/run_no_memory_cotest.py
# =============================================================================
#COTEST_JSONL=INTENT2FIX/benchmark/multi_swebench_cpp_change.jsonl
#COTEST_MAX_WORKERS=8
#COTEST_SHUTDOWN_GRACE_SECONDS=10
#COTEST_SUBMISSION_FILE=submission_deepseek-v4-flash_cpp.json
#COTEST_SKIP_INSTANCE_IDS=instance1,instance2
#COTEST_REPAIR_MODEL=deepseek-v4-flash
#COTEST_REPRO_MODEL=deepseek-v4-flash
#COTEST_RESULTS_DIR_PREFIX=results_deepseek-v4-flash
#COTEST_EXTRACTION_MODEL=deepseek/deepseek-v4-flash
# To run every stage through Volcengine Ark's pre-0731 build, use:
#COTEST_REPAIR_MODEL=volcengine-deepseek-v4-flash
#COTEST_REPRO_MODEL=volcengine-deepseek-v4-flash
#COTEST_EXTRACTION_MODEL=volcengine-deepseek-v4-flash
#COTEST_INTENT_DIALOGUE_MODEL=volcengine-deepseek-v4-flash
#COTEST_PATCH_REVIEW_MODEL=volcengine-deepseek-v4-flash
# To run every stage through Z.AI GLM-5.3-Flash, use:
#COTEST_REPAIR_MODEL=glm-5.3-flash
#COTEST_REPRO_MODEL=glm-5.3-flash
#COTEST_EXTRACTION_MODEL=glm-5.3-flash
#COTEST_INTENT_DIALOGUE_MODEL=glm-5.3-flash
#COTEST_PATCH_REVIEW_MODEL=glm-5.3-flash
#COTEST_DOCKER_REGISTRY=6pqg5gclf6yaz1ch6g.xuanyuan.run
#COTEST_ENABLE_INTENT=true
# Optional evidence-bounded Intent Grounding. It maps issue behavior to
# repository facts and compatibility risks without rewriting explicit issue text.
# Patch surface completeness is handled separately after Repair.
#COTEST_ENABLE_INTENT_GROUNDING=false
# Deprecated compatibility aliases for the switch above:
#COTEST_ENABLE_CAUSAL_INVESTIGATION=false
#COTEST_ENABLE_INTENT_DIALOGUE=false
# Legacy mode only: maximum TODOs emitted by the Evidence TODO Planner.
#COTEST_INTENT_MAX_TASKS=10
# Intent grounding strategy: contrastive (default) or legacy.
#COTEST_INTENT_DIALOGUE_MODE=contrastive
# Pre-retrieve and LLM-rank up to 10 repository test/example anchors.
#COTEST_INTENT_TEST_ANCHOR_RETRIEVAL=true
# Deprecated compatibility name:
#COTEST_INTENT_EXPLORATION_MAX_OBJECTIVES=10
# Deprecated compatibility alias for the TODO cap:
#COTEST_INTENT_DIALOGUE_MAX_ROUNDS=10
# Shared action budget for test-anchor selection, Issue-guided mutation,
# contrastive evidence refinement, and boundary-check materialization.
#COTEST_INTENT_EVIDENCE_STEPS=60
# Deprecated compatibility alias for the shared evidence budget:
#COTEST_INTENT_DIALOGUE_TOTAL_STEPS=60
# Fallback when TOTAL_STEPS is unset:
#COTEST_INTENT_INVESTIGATOR_STEPS=60
# Deprecated compatibility alias for the shared total budget:
#COTEST_INTENT_DIALOGUE_DEVELOPER_STEPS=60
#COTEST_INTENT_DIALOGUE_MODEL=deepseek/deepseek-v4-flash
# Provider generation budgets include both reasoning_content and final content
# or native tool arguments. DeepSeek V4 defaults to 128000 for both paths.
# Final tool fields are bounded separately in intent_dialogue/schema.py, so these
# values do not limit the compact answer/report fields.
#COTEST_INTENT_DIALOGUE_GENERATION_MAX_TOKENS=128000
#COTEST_INTENT_STRUCTURED_GENERATION_MAX_TOKENS=128000
# Deprecated fallback used only when the corresponding new key is unset:
#COTEST_INTENT_DIALOGUE_MAX_TOKENS=128000
# Optional pre-extracted LLVM toolchain mounted read-only into benchmark
# containers. Use a build compatible with the oldest benchmark glibc.
#COTEST_LLVM_TOOLCHAIN_DIR=/data/dqa/cache/llvm-toolchain
# Optional advisory post-VerifiedFinish structural surface reviewer. It keeps
# before/after patches and its report for ablation; one rejection triggers one
# same-context refinement without a second review.
# Defaults to true for test-derived contrastive intent and false otherwise.
# Set explicitly to false to run the whole-reviewer ablation.
#COTEST_ENABLE_PATCH_REVIEWER=true
#COTEST_PATCH_REVIEW_MODEL=deepseek/deepseek-v4-flash
#COTEST_PATCH_REVIEW_STEPS=50
#COTEST_PATCH_REVIEW_REFINE_STEPS=40
#COTEST_PATCH_REVIEW_MAX_TOKENS=16000
# Optional post-fix behavioral audit. It treats the candidate patch as an
# executable intent hypothesis and refines only an evidenced underfit probe.
#COTEST_ENABLE_PATCH_INTENT_AUDIT=false
#COTEST_PATCH_INTENT_AUDIT_MODEL=deepseek/deepseek-v4-flash
#COTEST_PATCH_INTENT_AUDIT_STEPS=40
#COTEST_PATCH_INTENT_AUDIT_REFINE_STEPS=40
#COTEST_PATCH_INTENT_AUDIT_MAX_TOKENS=16000
#COTEST_PATCH_INTENT_ADMISSION_MODEL=deepseek/deepseek-v4-flash
# Semantic admission is a bounded structured judgment, not another investigation.
#COTEST_PATCH_INTENT_ADMISSION_MAX_TOKENS=4096
#COTEST_PATCH_INTENT_ADMISSION_REASONING_EFFORT=low
#COTEST_DEEPSEEK_V4_THINKING=enabled
#COTEST_GLM_THINKING=enabled
# GLM-5.3-Flash forces thinking. `high` is the workflow default; use `max`
# only for targeted hard cases because it substantially increases tool-step latency.
#COTEST_GLM_REASONING_EFFORT=high
# GLM-specific total generation cap (reasoning plus final tool call). This is
# intentionally separate from the 128K DeepSeek stage settings below.
#COTEST_GLM_MAX_TOKENS=32768
#COTEST_REPRO_MAX_TOKENS=128000
#COTEST_REPAIR_MAX_TOKENS=128000
#COTEST_TEST_ENHANCEMENT_MAX_TOKENS=128000
#COTEST_ITERATIVE_REPAIR_MAX_TOKENS=128000
#COTEST_EXTRACTION_MAX_TOKENS=128000
# Retry transient provider connection, timeout, 5xx, and rate-limit errors.
#COTEST_PROVIDER_RETRY_ATTEMPTS=50
#COTEST_PROVIDER_RETRY_MIN_SECONDS=5
#COTEST_PROVIDER_RETRY_MAX_SECONDS=60
#COTEST_INTENT_GUARD=false
# Test-derived Intent does not need the standalone Reproducer. This legacy
# fallback is disabled by default and should be enabled only for compatibility
# experiments.
#COTEST_ENABLE_REPRODUCER_FALLBACK=false
#COTEST_REPRO_STEPS=50
#COTEST_REPAIR_STEPS=120
#COTEST_TEST_ENHANCEMENT_ROUNDS=1
#COTEST_TEST_ENHANCEMENT_STEPS=30
#COTEST_ITERATIVE_REPAIR_STEPS=40

