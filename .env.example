# =============================================================================
# code_intent/demo.py — 容器内 apt（可选）
# =============================================================================
# 国内 Ubuntu 源：aliyun / tsinghua / ustc / tencent / 163 / sjtu，或完整 http(s)://…/ubuntu/
# 显式把宿主机 clone 挂到容器内 --file-path（如 /home/ponyc）；不设则 /home/<repo> 不会仅因宿主机存在同名目录而挂载（ponyc 见上条 batch_index 自动挂载）
#CODE_INTENT_HOST_REPO_BIND=

# ponylang__ponyc-*：挂载宿主 Conda 环境到容器 /opt/code_intent_conda（须装齐 code_intent 依赖）
#CODE_INTENT_DOCKER_CONDA_PREFIX=/path/to/miniconda3/envs/your_env
# 宿主 Conda 的 libffi 等依赖较新 glibc；Ubuntu 16.04 镜像（glibc 2.23）常见
# ImportError: GLIBC_2.27 not found / ssl 不可用 → 换 18.04+ 基础镜像，或不挂载 Conda、改用容器内 Python。
# 可选：相对 bin 的解释器名（如 python3.11），或容器内绝对路径
#CODE_INTENT_DOCKER_CONDA_PYBIN=python3

# 容器内解释 demo.py 的可执行文件路径（优先于 Conda 自动探测；应为容器内路径）
#CODE_INTENT_DOCKER_PYTHON=/opt/code_intent_conda/bin/python3
# bear 失败后的 compiledb：若宿主 Conda 已 pip install compiledb==0.10.7，挂载进容器后会跳过 pip（避免老镜像内 SSL 坏导致装不上）
# 设为 1 则禁止 pip 安装 compiledb（未预装 compiledb 则直接退出）
#CODE_INTENT_SKIP_PIP_COMPILEDB=1

# demo 容器内：cmake | make-bear | auto（未传 CLI --build-backend 时生效）
#CODE_INTENT_BUILD_BACKEND=
# make-bear 时在源码根执行的 shell（与 --make-build-shell 等价；未传 CLI 时生效）
#CODE_INTENT_MAKE_BUILD_SHELL=

# 两阶段索引：容器只生成 compile_commands.json，宿主机再跑 libclang（避免老镜像 glibc 与宿主 Conda 不兼容）
#CODE_INTENT_COMPILE_DB_ONLY=1
# 宿主机解析时：容器内源码根|宿主 clone 根，如 /home/ponyc|/data/dqa/cache/repos/ponylang__ponyc-671
#CODE_INTENT_COMPILE_COMMANDS_PATH_MAP=

# code_intent/code_indexer.py — 加快索引、跳过第三方源码（仅影响 libclang 解析，不缩短 bear/编译 LLVM 的时间）
# 路径子串匹配规范化后的绝对路径，逗号分隔；命中则丢弃该 TU，且 standalone .h / extra TU 也受同一规则过滤
# ponyc 跳过 LLVM 子模块：用 ``lib/llvm/``（带斜杠，避免误伤 ``*lib/llvm*`` 文件名）；``batch_index`` / ``demo --host-index`` 对 ponyc 实例会自动追加
#CODE_INTENT_INDEX_EXCLUDE_PATH_SUBSTR=lib/llvm/
# 仅索引仓库内若干前缀（相对 project_root），如只索编译器本体：src,packages（与 EXCLUDE 二选一或组合用）
#CODE_INTENT_INDEX_PREFIXES=
# 跳过全仓库头文件遍历、跳过 extra TU 发现（进一步提速，可能漏头文件/未进 compile_commands 的 .cc）
#CODE_INTENT_INDEX_NO_STANDALONE_HEADERS=1
#CODE_INTENT_INDEX_NO_EXTRA_TU=1
# batch_index：为 1 时每个实例先容器 --compile-db-only，再**自动**宿主机 --host-index（完整两阶段）
#BATCH_INDEX_COMPILE_DB_ONLY=1
# 两阶段复用 compile_commands（慎用）：宿主设 BATCH_INDEX_SKIP_BUILD_CACHE_CLEAR=1 保留 build 目录；容器内需传入 CODE_INTENT_SKIP_BEAR_IF_COMPILE_COMMANDS_EXISTS=1（launch_docker 已转发）。仅同一 instance + 同一 checkout 安全；不同 PR/base_commit 勿复用。
#BATCH_INDEX_SKIP_BUILD_CACHE_CLEAR=0
#CODE_INTENT_SKIP_BEAR_IF_COMPILE_COMMANDS_EXISTS=0
# 仅跑阶段 2：--host-index-only --instance-id …；或 --host-index-from-summary-log code_intent/batch_index_summary.log（批量+实时统计）
#BATCH_INDEX_INSTANCE_ID=

#CODE_INTENT_APT_MIRROR=aliyun
# 为 1 时 apt 子进程也走 HTTP(S) 代理（默认 apt 会去掉代理以免 Ubuntu 官方源经代理 502）
#CODE_INTENT_APT_USE_PROXY=
#ENABLED_EDGE_TYPES=call,decl_ref,member_ref,type_ref,template_ref
#TEMPLATE_LOG_PATH=/tmp/template_debug.log
#TEMPLATE_DEBUG=0
#PARSE_LOG_PATH=/tmp/parse_debug.log
#PARSE_DEBUG=0
